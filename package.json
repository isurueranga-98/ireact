{
  "name": "ireactts",
  "version": "2.0.0",
  "description": "A modern React TypeScript starter template with React 19, TypeScript 5, and Tailwind CSS",
  "bin" : "./bin/cli.js",
  "keywords": ["react", "typescript", "starter", "template", "react19", "tailwindcss", "parcel"],
  "repository": {
    "type": "git",
    "url": "https://github.com/isurueranga-98/ireact.git"
  },
  "scripts": {
    "test": "tsc --noEmit",
    "start": "parcel public/index.html",
    "build": "parcel build public/index.html",
    "clean": "rm -rf dist .parcel-cache",
    "prepublishOnly": "npm run test && npm run build",
    "version": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "author": "Isuru Eranga",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.20",
    "parcel": "^2.15.4",
    "postcss": "^8.5.2",
    "process": "^0.11.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
